[sub_resource type="Resource" id="Line1"]
script = ExtResource("2")
text = "Nossa essa brincadeira foi demais... estou feliz por ter um amigo que brinca comigo."

[sub_resource type="Resource" id="Line2"]
script = ExtResource("2")
text = "Tá quente aqui né?! E sabe o que mais estou sentindo? Sinto cheiro de tempestade no ar..."

[sub_resource type="Resource" id="Line3"]
script = ExtResource("2")
text = "Minha mãe sempre falava que eu sou corajoso! Eu não tenho medo de chuvinhas... até gosto de me molhar, quando está calor, mas essa tempestade que está vindo aí é das grandes..."

[sub_resource type="Resource" id="Line4"]
script = ExtResource("2")
text = "Eu tenho um pouco de medo de tempestades... Onde será que vou me esconder?"
overlays = Array[Texture2D]([ExtResource("sad")])

[resource]
script = ExtResource("1")
title = "Eu Moro Aqui · Fase 3 — Abrigo na tempestade"
background = ExtResource("3")
overlays = Array[Texture2D]([ExtResource("happy")])
lines = Array[ExtResource("2")]([SubResource("Line1"), SubResource("Line2"), SubResource("Line3"), SubResource("Line4")])
